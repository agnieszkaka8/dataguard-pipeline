# DataGuard — required environment variables
# Copy this file to .env and fill in real values.
# .env is git-ignored; never commit real credentials.

# PostgreSQL DSN for the source database
SOURCE_DB=postgresql://user:password@source-host:5432/source_db

# PostgreSQL DSN for the target database
TARGET_DB=postgresql://user:password@target-host:5432/target_db

# Supabase project URL (Settings → API → Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase service-role key (Settings → API → service_role — keep secret)
SUPABASE_KEY=<service-role-key>
