{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write"
    ],
    "ask": [
      "Bash(git *)",
      "Bash(uv *)",
      "Bash(python *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/aga/dataguard-piepline && uv run ruff format . && uv run ruff check --fix . && uv run pytest --tb=short -q 2>&1 | tail -20"
          }
        ]
      }
    ]
  }
}